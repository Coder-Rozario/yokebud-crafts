<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let backend (api.yokebud.fi) serve always-fresh XML sitemaps from database
  # so AdminSitemap changes are reflected without redeploying dist.
  RewriteRule ^(sitemap\.xml)$ https://api.yokebud.fi/sitemap.xml [L,R=302]
  RewriteRule ^(product-sitemap\.xml)$ https://api.yokebud.fi/product-sitemap.xml [L,R=302]
  RewriteRule ^(category-sitemap\.xml)$ https://api.yokebud.fi/category-sitemap.xml [L,R=302]
  RewriteRule ^(page-sitemap\.xml)$ https://api.yokebud.fi/page-sitemap.xml [L,R=302]
  RewriteRule ^(blog-sitemap\.xml)$ https://api.yokebud.fi/blog-sitemap.xml [L,R=302]

  # Serve existing files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback to index.html for client-side routes
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Cache hashed assets aggressively (Vite outputs hashed filenames)
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|svg|ico|mp4|woff2?)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML should not be cached long
  <FilesMatch "\.(html)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
